# ==== Auth0 ====
# Create a tenant at https://auth0.com then:
# 1. Create an API: Identifier = https://api.kapyo.localhost  (audience)
# 2. Create a SPA application (for Angular + WordPress plugin)
# 3. Set Allowed Callback URLs:
#    http://kapyo.localhost, http://shop-a.localhost, http://shop-b.localhost
# 4. Set Allowed Logout URLs and Allowed Web Origins to the same URLs
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_API_AUDIENCE=https://api.kapyo.localhost
AUTH0_SPA_CLIENT_ID=your-spa-client-id

# ==== Kapyo Postgres ====
KAPYO_DB_USER=kapyo
KAPYO_DB_PASSWORD=kapyo
KAPYO_DB_NAME=kapyo

# ==== Per-site shared secrets (storefront <-> API identification) ====
# These prove an add-to-cart request originates from a known storefront
# (WooCommerce plugin or Shopify app). Rotate in production.
SITE_A_KEY=change-me-site-a
SITE_B_KEY=change-me-site-b
SITE_C_KEY=change-me-site-c

# ==== Platform selector per site ====
# Each site is either "woocommerce" or "shopify". site-a / site-b ship as
# WooCommerce; site-c ships as the Shopify example (left inactive until its
# credentials below are filled in).
SHOP_A_PLATFORM=woocommerce
SHOP_B_PLATFORM=woocommerce
SHOP_C_PLATFORM=shopify

# ==== CORS ====
CORS_ORIGINS=http://kapyo.localhost,http://shop-a.localhost,http://shop-b.localhost

# ==== B2B access ====
# Two ways to grant B2B access. The token check is preferred (Auth0 RBAC):
#   - assign the `b2b:read` permission to a user/role on the API, OR
#   - emit a custom claim `https://kapyo/roles` containing "b2b" via an Auth0 Action.
# As a fallback for demos, list emails below (comma-separated, lower-cased).
B2B_EMAILS=

# ==== Cart validity (TTL) ====
# How long a Kapyo cart item lives. The spec recommends 30 min to 7 days.
# Set to 0 to disable expiry.
CART_TTL_SECONDS=604800

# ==== Plugin active-products reconciliation ====
# Kapyo pushes touch/forget on every cart mutation. This periodic task does a
# full replace of each shop's kapyo_active_products table to recover from
# missed updates. Set to 0 to disable.
ACTIVE_PRODUCTS_RECONCILE_SECONDS=3600

# ==== Stripe (PSP for unified checkout) ====
# Use test keys from https://dashboard.stripe.com/test/apikeys.
# When both are set, the SPA uses the Stripe-backed checkout (one-time
# user payment, then Kapyo creates each WC order with the Stripe charge id
# stored as transaction_id).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ==== WooCommerce REST API credentials for Kapyo checkout ====
# Seeded verbatim into wp_woocommerce_api_keys by wordpress/init/setup.sh.
# Kapyo uses them (query-string auth) to create orders on each site.
SHOP_A_WC_CONSUMER_KEY=ck_kapyo_shop-a
SHOP_A_WC_CONSUMER_SECRET=cs_kapyo_shop-a_secret
SHOP_B_WC_CONSUMER_KEY=ck_kapyo_shop-b
SHOP_B_WC_CONSUMER_SECRET=cs_kapyo_shop-b_secret

# ==== Shopify credentials for the site-c target (optional) ====
# Create a custom app in the Shopify admin (Settings > Apps and sales channels
# > Develop apps), grant it read/write on products, orders and draft orders,
# then install it and copy the Admin API access token (shpat_...).
# Leave SHOP_C_SHOPIFY_DOMAIN empty to keep the demo WooCommerce-only.
SHOP_C_HOST=
SHOP_C_SHOPIFY_DOMAIN=                # my-shop.myshopify.com
SHOP_C_SHOPIFY_ADMIN_TOKEN=          # shpat_xxx
SHOP_C_SHOPIFY_STOREFRONT_TOKEN=     # optional, for storefront-side flows
SHOP_C_SHOPIFY_API_VERSION=2024-10
# Webhook signing secret (Shopify admin > Notifications > Webhooks, or the
# app's API secret). Used to verify inbound Shopify webhooks.
SHOP_C_SHOPIFY_WEBHOOK_SECRET=
