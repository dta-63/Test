# ==== Auth0 ====
# Create a tenant at https://auth0.com then:
# 1. Create an API: Identifier = https://api.pimp.localhost  (audience)
# 2. Create a SPA application (for Angular + WordPress plugin)
# 3. Set Allowed Callback URLs:
#    http://pimp.localhost, http://shop-a.localhost, http://shop-b.localhost
# 4. Set Allowed Logout URLs and Allowed Web Origins to the same URLs
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_API_AUDIENCE=https://api.pimp.localhost
AUTH0_SPA_CLIENT_ID=your-spa-client-id

# ==== Pimp Postgres ====
PIMP_DB_USER=pimp
PIMP_DB_PASSWORD=pimp
PIMP_DB_NAME=pimp

# ==== Per-site shared secrets (plugin <-> API identification) ====
# These prove a request originates from a known WordPress site.
# Rotate in production.
SITE_A_KEY=change-me-site-a
SITE_B_KEY=change-me-site-b

# ==== CORS ====
CORS_ORIGINS=http://pimp.localhost,http://shop-a.localhost,http://shop-b.localhost

# ==== B2B access ====
# Two ways to grant B2B access. The token check is preferred (Auth0 RBAC):
#   - assign the `b2b:read` permission to a user/role on the API, OR
#   - emit a custom claim `https://pimp/roles` containing "b2b" via an Auth0 Action.
# As a fallback for demos, list emails below (comma-separated, lower-cased).
B2B_EMAILS=

# ==== Cart validity (TTL) ====
# How long a Pimp cart item lives. The spec recommends 30 min to 7 days.
# Set to 0 to disable expiry.
CART_TTL_SECONDS=604800

# ==== Stripe (PSP for unified checkout) ====
# Use test keys from https://dashboard.stripe.com/test/apikeys.
# When both are set, the SPA uses the Stripe-backed checkout (one-time
# user payment, then Pimp creates each WC order with the Stripe charge id
# stored as transaction_id).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ==== WooCommerce REST API credentials for Pimp checkout ====
# Seeded verbatim into wp_woocommerce_api_keys by wordpress/init/setup.sh.
# Pimp uses them (query-string auth) to create orders on each site.
SHOP_A_WC_CONSUMER_KEY=ck_pimp_shop-a
SHOP_A_WC_CONSUMER_SECRET=cs_pimp_shop-a_secret
SHOP_B_WC_CONSUMER_KEY=ck_pimp_shop-b
SHOP_B_WC_CONSUMER_SECRET=cs_pimp_shop-b_secret
